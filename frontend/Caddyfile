{$SITE_ADDRESS::80} {
    # Compress everything EXCEPT the live SSE stream — gzip buffers a streaming response and would
    # stall the Server-Sent Events (the live processing preview).
    @notlive not path /api/v1/jobs/*/live
    encode @notlive zstd gzip

    # Live preview SSE: no buffering, flush every write so detection boxes arrive in real time.
    handle /api/v1/jobs/*/live {
        reverse_proxy backend:8000 {
            flush_interval -1
        }
    }

    handle /api/* {
        reverse_proxy backend:8000
    }

    @api_docs path /docs* /redoc* /openapi.json
    handle @api_docs {
        reverse_proxy backend:8000
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
