APP_NAME=DatVision GT
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO

HTTP_PORT=5173
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

POSTGRES_DB=datvision_gt
POSTGRES_USER=datvision
POSTGRES_PASSWORD=change_me_before_deploy
DATABASE_URL=postgresql+psycopg://datvision:change_me_before_deploy@postgres:5432/datvision_gt

REDIS_URL=redis://redis:6379/0
RQ_QUEUE=datvision

STORAGE_ROOT=/app/storage
MODEL_ROOT=/app/models

# Production only. Example: gt.example.com
DOMAIN=
DATA_ROOT=./storage
MODEL_DATA_ROOT=./models

# Cloud OCR cross-check (second, independent reader per plate). Runs as an opt-in review step,
# never inside the offline video worker. Leave disabled to keep the pipeline fully offline.
CLOUD_OCR_ENABLED=false
CLOUD_OCR_TIMEOUT_S=30
# Reader A — OpenAI (GPT)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_OCR_MODEL=gpt-5.6-terra
# Reader B — Qwen (Alibaba DashScope, OpenAI-compatible). Different vendor = real cross-check.
QWEN_API_KEY=
QWEN_BASE_URL=https://api.openai.com/v1
QWEN_OCR_MODEL=gpt-4.1-mini

